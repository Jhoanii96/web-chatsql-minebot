# Flask
FLASK_SECRET_KEY="replace-with-a-random-secret"

# Azure SQL Database
SQL_SERVER_STR="DRIVER={ODBC Driver 17 for SQL Server};SERVER=<server>.database.windows.net;DATABASE=<database>;UID=<user>;PWD=<password>;"
SQL_SCHEMA="mbot"
SQL_TIMEOUT=120

# OpenAI
OPENAI_API_KEY=""
AZURE_OPENAI_KEY=""
AZURE_OPENAI_BASE="https://<resource>.cognitiveservices.azure.com/"
AZURE_OPENAI_URL_API_VERSION=""

# Pinecone
PINECONE_KEY=""
PINECONE_INDEX=""

# Azure Blob Storage
BLOB_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<account-key>;EndpointSuffix=core.windows.net"
BLOB_DEFAULT_IMAGE_CONTAINER="landing"
BLOB_DEFAULT_DATA_CONTAINER="raw"
BLOB_IMAGE_PATH="ChatFlow/Images"

# Weather API
WEATHER_API_KEY=""

# Power BI REST API
PBI_TENANT_ID=""
PBI_CLIENT_ID=""
PBI_CLIENT_SECRET=""
PBI_WORKSPACE=""

# Azure Key Vault
KEYVAULT_URL="https://<vault-name>.vault.azure.net/"

# Microsoft Entra ID
AUTHENTICATE_WITH_AZURE=1
AD_CLIENT_ID=""
AD_CLIENT_SECRET=""
AD_TENANT_ID=""

# Application
WEB_APP_VERSION="Full"
